CONFIG_IDF_TARGET_ESP8266=y
CONFIG_IDF_TARGET="esp8266"

# Désactiver tous les watchdogs
CONFIG_ESP8266_NMI_WDT=n
CONFIG_ESP_TASK_WDT=n
CONFIG_TASK_WDT=n

# Options minimales requises pour un projet de base
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP8266_XTAL_FREQ_26=y
CONFIG_ESP8266_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP8266_DEFAULT_CPU_FREQ_MHZ=160

# Partition table single app
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp.csv"

# Compiler options
CONFIG_COMPILER_OPTIMIZATION_LEVEL_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y

# Désactiver la gestion du WiFi et autres fonctionnalités avancées pour rester minimaliste
CONFIG_ESP8266_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Désactiver la gestion du TLS/SSL pour rester minimaliste
CONFIG_ESP_TLS_USING_MBEDTLS=n

# Désactiver la gestion du log avancé
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Augmenter la taille de la pile du thread principal
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Fin du fichier minimaliste
